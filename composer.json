{
    "name": "tattali/utm-cookie-bundle",
    "type": "symfony-bundle",
    "description": "This bundle allow you to save utm parameters from url into a cookie when they exists. It's also provide a bunch of tools to easily retrive all or each utm.",
    "homepage": "https://github.com/tattali/UtmCookieBundle",
    "keywords": ["utm", "cookie", "symfony", "symfony utm"],
    "license": "MIT",
    "authors": [
        {
            "name": "Yannick Cenatiempo",
            "email": "yannick.cenatiempo@medelse.com"
        },
        {
            "name": "Théo Attali",
            "email": "theoattali@gmail.com",
            "homepage": "https://theoattali.fr"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-filter": "*",
        "symfony/config": "^6.4.26",
        "symfony/dependency-injection": "^6.4.26",
        "symfony/framework-bundle": "^6.4.26",
        "symfony/http-kernel": "^6.4.26",
        "symfony/polyfill-ctype": "^1.8",
        "symfony/polyfill-mbstring": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "UtmCookieBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UtmCookieBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.5.40 || ^11.5 || ^12.5 || ^13.4",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/cache-contracts": "^2.5.4 || ^3.6",
        "symfony/http-foundation": "^6.4.26",
        "symfony/error-handler": "^6.4.26",
        "symfony/event-dispatcher": "^6.4.26",
        "symfony/event-dispatcher-contracts": "^2.5.3 || ^3.6",
        "symfony/filesystem": "^6.4.26"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
